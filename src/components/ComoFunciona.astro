---
import { Image } from 'astro:assets';
import { img } from '../lib/img';
import { pasos } from '../data/site';
---

<section class="seccion" id="como-funciona">
  <div class="contenedor">
    <div class="cabecera" data-aparece>
      <h2>De la consulta a la primera clase</h2>
      <p>Cuatro pasos y el alumno ya está aprendiendo, sin papeleo ni filas.</p>
    </div>

    <!-- Un camino de cuatro paradas, como un tablero: la linea punteada une
         las casillas y el numero dice en cual se esta. -->
    <ol class="camino">
      {
        pasos.map((p, i) => (
          <li class="parada" data-aparece style={`--i: ${i}`}>
            <div class="casilla">
              <span class="numero">{i + 1}</span>
              <Image src={img(`mascota-${p.pose}`)} alt="" width={400} />
            </div>
            <div class="parada-texto">
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .camino {
    --casilla: clamp(150px, 16vw, 196px);
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(16px, 2.4vw, 32px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* La linea del camino, de la primera casilla a la ultima, por detras. */
  .camino::before {
    content: '';
    position: absolute;
    top: calc(var(--casilla) / 2);
    left: calc(var(--casilla) / 2);
    right: calc(25% - var(--casilla) / 2);
    border-top: 3px dashed var(--borde);
  }

  .parada { position: relative; display: grid; gap: 22px; align-content: start; }

  .casilla {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--casilla);
    height: var(--casilla);
    border-radius: 50%;
    background: var(--acento-suave);
  }

  .parada:nth-child(even) .casilla { background: var(--fondo-2); box-shadow: inset 0 0 0 2px var(--borde); }

  /* La llegada: la casilla del color de la marca. */
  .parada:last-child .casilla { background: var(--acento); }

  .casilla img {
    position: absolute;
    inset: 13%;
    width: 74%;
    height: 74%;
    object-fit: contain;
    transition: scale 0.4s var(--rebote), rotate 0.4s var(--rebote);
  }

  @media (hover: hover) and (pointer: fine) {
    .parada:hover .casilla img { scale: 1.08; rotate: -3deg; }
  }

  .numero {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--tinta);
    color: #fff;
    font-size: 1.15rem;
    font-weight: 800;
    box-shadow: 0 0 0 5px var(--fondo);
  }

  .parada-texto { display: grid; gap: 8px; max-width: 17rem; }
  .parada-texto h3 { font-size: 1.3rem; }
  .parada-texto p { color: var(--texto-suave); font-size: 0.97rem; }

  @media (max-width: 900px) {
    .camino { grid-template-columns: repeat(2, 1fr); row-gap: 40px; }
    .camino::before { display: none; }
  }

  /* En el celular el camino baja: casillas a la izquierda, unidas por la
     misma linea punteada, ahora vertical. */
  @media (max-width: 560px) {
    .camino { --casilla: 104px; grid-template-columns: 1fr; row-gap: 28px; }

    .camino::before {
      display: block;
      top: calc(var(--casilla) / 2);
      bottom: calc(var(--casilla) / 2);
      left: calc(var(--casilla) / 2);
      right: auto;
      border-top: 0;
      border-left: 3px dashed var(--borde);
    }

    .parada { grid-template-columns: var(--casilla) 1fr; gap: 18px; align-items: center; }
    .numero { width: 34px; height: 34px; font-size: 0.95rem; box-shadow: 0 0 0 4px var(--fondo); }
    .parada-texto h3 { font-size: 1.15rem; }
  }
</style>
