---
import QRCode from 'qrcode';
import { Image } from 'astro:assets';
import { img } from '../lib/img';
import { academia, app, descarga } from '../data/site';

// El codigo se dibuja al compilar: la web no carga ninguna libreria para esto.
// El QR necesita la direccion completa: lo lee otro telefono, no esta pagina.
const qr = await QRCode.toString(new URL(app.apk, academia.url).href, {
  type: 'svg',
  margin: 0,
  errorCorrectionLevel: 'M',
  color: { dark: '#1A1730', light: '#0000' },
});

const pedirCuenta = `https://wa.me/${academia.whatsapp}?text=${encodeURIComponent(
  'Hola, quiero la cuenta de la app SMARTER para mi hijo/a.',
)}`;
---

<section class="seccion descarga" id="descarga">
  <div class="contenedor">
    <div class="arriba">
      <div class="texto" data-aparece>
        <h2>Descarga la app</h2>
        <p class="bajada">
          Horario, asistencia, notas, pagos y el Banco SMARTER, en el celular.{' '}
          <span class="solo-android">En Android se instala; en iPhone y en la
          computadora, se usa desde el navegador.</span>
        </p>

        <div class="acciones">
          <a class="boton boton-campo" href={app.apk} rel="nofollow">
            <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
              <path d="M17.6 9.48l1.84-3.18a.38.38 0 00-.66-.38l-1.86 3.22a11.5 11.5 0 00-9.84 0L5.22 5.92a.38.38 0 00-.66.38L6.4 9.48A10.8 10.8 0 001 18h22a10.8 10.8 0 00-5.4-8.52zM7 15.25a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5zm10 0a1.25 1.25 0 110-2.5 1.25 1.25 0 010 2.5z" />
            </svg>
            Descargar para Android
          </a>
          <span class="requisito">Versión <span data-version>{app.version}</span> · {app.requisito}</span>
        </div>

        <!-- En un iPhone el APK no sirve: se ofrece la version web, con los
             tres toques para dejarla en la pantalla de inicio. -->
        <div class="aviso-iphone" hidden>
          <p class="aviso-titulo">¿Tienes iPhone? Úsala desde Safari</p>
          <ol>
            <li>Abre la versión web.</li>
            <li>Toca <strong>Compartir</strong> (el cuadrado con la flecha).</li>
            <li>Elige <strong>Agregar a inicio</strong>.</li>
          </ol>
          <a class="boton boton-campo" href={app.web}>Abrir SMARTER en el navegador</a>
        </div>
        <!-- En la computadora el APK no se instala: va primero la version web.
             Para el celular Android queda el QR de al lado. -->
        <div class="en-compu" hidden>
          <a class="boton boton-campo" href={app.web}>Abrir SMARTER en el navegador</a>
          <p>
            Para tenerla como una app: en Safari, menú <strong>Archivo › Agregar al
            Dock</strong>; en Chrome o Edge, el ícono de instalar en la barra de
            direcciones.
          </p>
        </div>
        <p class="otra-forma">
          ¿En la computadora o en un iPhone?{' '}
          <a href={app.web}>Úsala desde el navegador</a>.
        </p>
      </div>

      <!-- El QR como una calcomania pegada, con la mascota asomada detras. -->
      <div class="qr-zona" data-aparece="pop" style="--i: 2">
        <Image class="qr-mascota" src={img('mascota-leyendo')} alt="" width={420} />
        <div class="qr">
          <div class="qr-codigo" set:html={qr} role="img" aria-label="Código QR para descargar la app" />
          <p>¿Estás en la computadora? Escanéalo con la cámara de tu Android.</p>
        </div>
      </div>
    </div>

    <ol class="instalar">
      {
        descarga.pasos.map((p, i) => (
          <li data-aparece style={`--i: ${i}`}>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </li>
        ))
      }
    </ol>

    <p class="sin-cuenta">
      ¿Todavía no tienes cuenta? La crea la academia cuando el alumno se
      matricula. <a href={pedirCuenta} target="_blank" rel="noopener">Pídela por WhatsApp</a>.
    </p>
  </div>
</section>

<script>
  // El APK solo sirve en un celular Android. En un iPhone el boton bajaria un
  // archivo que no se puede abrir, y en la computadora tampoco se instala: a
  // los dos se les ofrece primero la version web. Los iPad nuevos dicen ser
  // una Mac, pero son los unicos "Mac" con pantalla tactil.
  const ua = navigator.userAgent;
  const esIos =
    /iPhone|iPad|iPod/.test(ua) || (ua.includes('Macintosh') && navigator.maxTouchPoints > 1);
  const esAndroid = /Android/.test(ua);
  const descarga = document.querySelector('.descarga');
  if (esIos) {
    // Lo del APK no le sirve: fuera el boton, los pasos para instalarlo y el
    // texto que habla de Android. Queda solo el camino del iPhone.
    descarga?.classList.add('es-ios');
    document.querySelector('.aviso-iphone')?.removeAttribute('hidden');
    document.querySelector('.otra-forma')?.setAttribute('hidden', '');
  } else if (!esAndroid) {
    // Computadora: la web adelante; el QR y los pasos siguen para quien
    // quiera instalarla en su Android.
    descarga?.classList.add('es-compu');
    document.querySelector('.en-compu')?.removeAttribute('hidden');
    document.querySelector('.otra-forma')?.setAttribute('hidden', '');
  }

  // La version que se baja de verdad. Si no responde, queda la del sitio.
  fetch('/descargar/info')
    .then((r) => (r.ok ? r.json() : null))
    .then((info) => {
      const donde = document.querySelector('[data-version]');
      if (info?.version && donde) donde.textContent = info.version;
    })
    .catch(() => {});
</script>

<style>
  /* Segundo campo de color de la pagina: aqui se viene a hacer una cosa. */
  .descarga {
    position: relative;
    overflow: hidden;
    color: var(--sobre-campo);
    background:
      var(--garabatos-claros),
      radial-gradient(50% 70% at 84% 22%, var(--campo-luz) 0%, transparent 70%),
      var(--campo);
  }

  .arriba {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: center;
    gap: clamp(32px, 5vw, 72px);
  }

  .texto { display: grid; gap: 20px; justify-items: start; }
  h2 { font-size: clamp(2.6rem, 7vw, 5rem); letter-spacing: -0.04em; line-height: 0.98; }
  .bajada { max-width: 30rem; font-size: 1.15rem; font-weight: 500; }

  .acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 20px; margin-top: 4px; }
  .requisito { font-size: 0.9rem; font-weight: 500; }

  .aviso-iphone {
    display: grid;
    gap: 10px;
    justify-items: start;
    max-width: 30rem;
    padding: 18px 20px;
    border-radius: 16px;
    background: #fff;
    color: var(--tinta);
    font-size: 0.95rem;
  }

  .aviso-iphone[hidden] { display: none; }

  .aviso-titulo { font-weight: 700; font-size: 1.02rem; }

  .aviso-iphone ol {
    margin: 0;
    padding-left: 1.2em;
    display: grid;
    gap: 2px;
    font-weight: 500;
  }

  /* Aqui el boton va sobre blanco, no sobre el campo de color: tinta con
     letra blanca, que se lee igual con los colores de cualquier temporada. */
  .aviso-iphone .boton-campo {
    margin-top: 4px;
    background: var(--tinta);
    color: #fff;
    box-shadow: 0 5px 0 #000;
  }

  .aviso-iphone .boton-campo:active { box-shadow: 0 1px 0 #000; }

  .es-ios .acciones,
  .es-ios .instalar,
  .es-ios .solo-android,
  .es-ios .qr-zona { display: none; }
  .es-ios .arriba { grid-template-columns: 1fr; }

  .es-compu .acciones { display: none; }

  .en-compu { display: grid; gap: 14px; justify-items: start; max-width: 30rem; margin-top: 4px; }
  .en-compu[hidden] { display: none; }
  .en-compu p { font-size: 0.93rem; font-weight: 500; }

  .otra-forma { font-size: 0.93rem; font-weight: 500; }
  .otra-forma a { font-weight: 700; }

  .qr-zona { position: relative; justify-self: center; padding-top: 96px; }

  .qr-mascota {
    position: absolute;
    left: 50%;
    top: 0;
    width: 190px;
    translate: -50% 0;
    filter: drop-shadow(0 10px 12px rgba(60, 0, 32, 0.3));
  }

  .qr {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 14px;
    width: min(100%, 280px);
    padding: 26px 24px 22px;
    border-radius: 24px;
    background: #fff;
    color: var(--tinta);
    text-align: center;
    rotate: -3deg;
    box-shadow: 0 22px 40px rgba(60, 0, 32, 0.32);
    transition: rotate 0.4s var(--rebote);
  }

  @media (hover: hover) and (pointer: fine) {
    .qr:hover { rotate: 0deg; }
  }

  .qr-codigo { width: 176px; }
  .qr-codigo :global(svg) { width: 100%; height: auto; }
  .qr p { font-size: 0.88rem; font-weight: 500; color: var(--texto-suave); line-height: 1.45; }

  .instalar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 44px);
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 28px 0 0;
    border-top: 1px solid var(--campo-linea);
    list-style: none;
  }

  .instalar li { display: grid; gap: 8px; align-content: start; }

  /* El numero del paso, hueco: solo el borde. */
  .n {
    font-size: clamp(3rem, 5vw, 4.2rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 2px var(--sobre-campo);
  }

  .instalar h3 { margin-top: 6px; font-size: 1.2rem; }
  .instalar p { font-size: 0.97rem; }

  .sin-cuenta { margin-top: 36px; font-weight: 500; }
  .sin-cuenta a { font-weight: 700; }

  @media (max-width: 860px) {
    .arriba { grid-template-columns: 1fr; }
    .instalar { grid-template-columns: 1fr; gap: 24px; }
    .instalar li { grid-template-columns: 56px 1fr; column-gap: 12px; }
    .n { grid-row: 1 / 3; font-size: 3.2rem; }
    .instalar h3 { margin-top: 2px; }
  }

  /* En el celular el QR no sirve: ya se esta en el telefono. */
  @media (max-width: 600px) {
    .qr-zona { display: none; }
  }
</style>
