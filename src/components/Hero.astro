---
import { Image } from 'astro:assets';
import { img } from '../lib/img';
import { cifras } from '../data/site';
---

<section class="hero">
  <div class="contenedor hero-grid">
    <div class="hero-texto">
      <span class="etiqueta" data-aparece>Inscripciones abiertas · Inicio cada mes</span>
      <h1 data-aparece style="--i: 1">Creando mentes <em>brillantes</em>, hoy y siempre.</h1>
      <p class="hero-bajada" data-aparece style="--i: 2">
        Clases de primaria y secundaria en grupos pequeños o particulares,
        virtuales o presenciales. Y una app donde cada avance se gana en
        monedas.
      </p>
      <div class="hero-botones" data-aparece style="--i: 3">
        <a href="#inscripcion" class="boton boton-rosa">Quiero inscribirme</a>
        <a href="#descarga" class="boton boton-borde">Descargar la app</a>
      </div>
      <dl class="hero-cifras" data-aparece style="--i: 4">
        {
          cifras.map((c) => (
            <div>
              <dt>{c.texto}</dt>
              <dd data-contar={c.valor}>{c.valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="hero-arte" aria-hidden="true" data-aparece="zoom" style="--i: 2">
      <div class="hero-mancha"></div>
      <Image class="hero-mascota" src={img('mascota')} alt="" width={720} loading="eager" />
      <Image class="flota flota-1" src={img('avatar_circulo')} alt="" width={180} loading="eager" />
      <Image class="flota flota-2" src={img('avatar_triangulo')} alt="" width={160} loading="eager" />
      <Image class="flota flota-3" src={img('avatar_otorongo')} alt="" width={220} loading="eager" />
      <span class="moneda-chip">+20 monedas</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(40px, 7vw, 88px) clamp(56px, 8vw, 96px);
    background: var(--garabatos), linear-gradient(180deg, #fff 0%, var(--fondo-2) 100%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: clamp(24px, 5vw, 64px);
  }

  .hero-texto { display: grid; gap: 22px; justify-items: start; }

  h1 {
    font-size: clamp(2.6rem, 6.4vw, 4.6rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  h1 em {
    font-style: normal;
    color: var(--rosa);
    background: linear-gradient(transparent 68%, var(--rosa-suave) 68%);
  }

  .hero-bajada {
    max-width: 34rem;
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--texto-suave);
  }

  .hero-botones { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 4px; }

  .hero-cifras {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 36px;
    margin: 12px 0 0;
    padding-top: 22px;
    border-top: 1px solid var(--borde);
  }

  .hero-cifras div { display: flex; flex-direction: column-reverse; }
  .hero-cifras dd {
    margin: 0;
    font-size: 1.9rem;
    font-weight: 800;
    line-height: 1.1;
    color: var(--tinta);
    font-variant-numeric: tabular-nums;
  }
  .hero-cifras dt { font-size: 0.9rem; color: var(--texto-suave); }

  .hero-arte {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 460px;
  }

  .hero-mancha {
    position: absolute;
    inset: 8% 4% 4%;
    border-radius: 46% 54% 42% 58% / 52% 44% 56% 48%;
    background: radial-gradient(circle at 35% 30%, #fff 0%, var(--rosa-suave) 55%, #FFD0E8 100%);
  }

  .hero-mascota {
    position: relative;
    width: min(360px, 78%);
    filter: drop-shadow(0 18px 24px rgba(26, 23, 48, 0.18));
    animation: vaiven 6s ease-in-out infinite;
  }

  .flota {
    position: absolute;
    filter: drop-shadow(0 10px 14px rgba(26, 23, 48, 0.2));
    animation: flotar 5s ease-in-out infinite;
  }

  .flota-1 { width: 84px; left: 2%; top: 14%; }
  .flota-2 { width: 76px; right: 4%; top: 6%; animation-delay: -1.6s; }
  .flota-3 { width: 104px; right: 0; bottom: 8%; animation-delay: -3.1s; }

  .moneda-chip {
    position: absolute;
    left: 0;
    bottom: 18%;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--tinta);
    color: #fff;
    font-weight: 700;
    font-size: 0.95rem;
    box-shadow: 0 10px 24px rgba(26, 23, 48, 0.25);
    transform: rotate(-6deg);
    animation: vaiven 4s ease-in-out -1s infinite;
  }

  .moneda-chip::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--oro);
    vertical-align: 1px;
  }

  @keyframes flotar {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-14px) rotate(3deg); }
  }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-arte { min-height: 340px; max-width: 420px; width: 100%; justify-self: center; }
    .flota-1 { width: 64px; }
    .flota-2 { width: 58px; }
    .flota-3 { width: 80px; }
  }
</style>
