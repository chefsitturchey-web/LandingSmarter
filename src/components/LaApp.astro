---
import { Image } from 'astro:assets';
import { img } from '../lib/img';
import { enLaApp, monedas } from '../data/site';
import Forma from './Forma.astro';

const figuras = ['circulo', 'cuadrado'] as const;
---

<section class="seccion app" id="la-app">
  <div class="contenedor">
    <div class="app-grid">
      <div class="app-texto" data-aparece>
        <h2>Aprender se nota. Y se gana.</h2>
        <p class="app-bajada">
          Cada alumno tiene su jugador. Cuando participa, avanza o destaca en
          clase, su docente le da monedas; con ellas viste a su jugador en la
          Tienda SMARTER. Y la familia lo sigue todo desde el celular.
        </p>

        <div class="roles">
          {
            enLaApp.map((r, i) => (
              <div class="rol">
                <h3>
                  <Forma tipo={figuras[i]} class="rol-figura" grosor={12} />
                  {r.quien}
                </h3>
                <ul>
                  {r.cosas.map((c) => <li>{c}</li>)}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div class="telefonos" aria-label="Pantallas de la app" data-aparece style="--i: 2">
        <figure class="telefono telefono-atras">
          <Image src={img('app-tienda')} alt="La Tienda SMARTER: el jugador con su ropa y las piezas que se pueden comprar" width={600} />
        </figure>
        <figure class="telefono telefono-frente">
          <Image src={img('app-perfil')} alt="El perfil del alumno: su carta de jugador, sus monedas y sus medallas" width={600} />
        </figure>
        <Image class="pegado pegado-1" src={img('sticker-tu-puedes')} alt="" width={240} />
        <Image class="pegado pegado-2" src={img('medalla-concurso-oro')} alt="" width={180} />
      </div>
    </div>

    <!-- El Banco: una escalera. Cada personaje esta parado en su peldano, y
         cada peldano vale el doble que el de abajo. -->
    <div class="banco" id="banco">
      <div class="banco-texto" data-aparece>
        <h3>El Banco SMARTER</h3>
        <p>Cinco personajes, cada uno vale el doble que el anterior. Juntar vale más que gastar.</p>
      </div>

      <ol class="escalera">
        {
          monedas.map((m, i) => (
            <li style={`--n: ${i}; --i: ${i}`} data-aparece="pop">
              <Image src={img(m.img)} alt="" width={240} />
              <div class="peldano">
                <strong>{m.nombre}</strong>
                <span><b>{m.valor}</b> monedas</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="tienda">
      <div class="tienda-texto" data-aparece>
        <h3>La Tienda SMARTER</h3>
        <p>
          Pelo, ropa, accesorios, fondos y stickers: cada alumno arma su
          jugador a su gusto. Las monedas solo se ganan aprendiendo, nunca se
          compran.
        </p>
      </div>

      <div class="jugadores" aria-hidden="true">
        {[1, 2, 3, 4, 5].map((n) => (
          <div class="jugador" data-aparece="pop" style={`--i: ${n - 1}`}>
            <Image src={img(`jugador-${n}`)} alt="" width={340} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .app {
    position: relative;
    color: #fff;
    background: var(--garabatos-claros), var(--tinta);
  }

  .app-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(32px, 6vw, 80px);
  }

  .app-texto { display: grid; gap: 22px; align-content: start; }

  .app-bajada { max-width: 34rem; font-size: 1.1rem; color: rgba(255, 255, 255, 0.86); }

  /* Quien hace que: dos listas bajo una regla, sin cajas. */
  .roles {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
    margin-top: 14px;
  }

  .rol { padding-top: 20px; border-top: 2px solid rgba(255, 255, 255, 0.22); }

  .rol h3 { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; font-size: 1.1rem; }
  .rol-figura { width: 16px; color: var(--acento); }

  .rol ul { display: grid; gap: 9px; margin: 0; padding: 0; list-style: none; }

  .rol li { font-size: 0.94rem; line-height: 1.5; color: rgba(255, 255, 255, 0.84); }

  .telefonos {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    align-items: center;
    min-height: 560px;
  }

  .telefono {
    margin: 0;
    padding: 8px;
    border-radius: 38px;
    background: #0D0B1C;
    box-shadow: 0 30px 50px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    animation: vaiven 7s ease-in-out infinite;
  }

  .telefono img { width: 100%; border-radius: 30px; }

  .telefono-atras { grid-column: 1 / 7; grid-row: 1; rotate: -6deg; margin-top: 48px; animation-delay: -3.5s; }
  .telefono-frente { grid-column: 5 / 12; grid-row: 1; position: relative; rotate: 3deg; }

  .pegado {
    position: absolute;
    filter: drop-shadow(0 8px 10px rgba(0, 0, 0, 0.4));
    animation: vaiven 5s ease-in-out -2s infinite;
  }
  .pegado-1 { width: 110px; right: -2%; top: 2%; rotate: 10deg; }
  .pegado-2 { width: 78px; left: 2%; bottom: 4%; rotate: -10deg; }

  /* --- El Banco ---------------------------------------------------------- */

  .banco {
    display: grid;
    grid-template-columns: 4fr 8fr;
    align-items: end;
    gap: clamp(24px, 4vw, 56px);
    margin-top: clamp(72px, 9vw, 120px);
  }

  .banco-texto { display: grid; gap: 12px; padding-bottom: 6px; }
  .banco-texto h3, .tienda-texto h3 { font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.05; }
  .banco-texto p, .tienda-texto p { color: rgba(255, 255, 255, 0.84); }

  .escalera {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    align-items: end;
    gap: clamp(4px, 0.9vw, 12px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .escalera li { display: grid; justify-items: center; }

  .escalera img {
    width: clamp(52px, 62%, 104px);
    margin-bottom: -6px;
    filter: drop-shadow(0 8px 8px rgba(0, 0, 0, 0.35));
    transition: translate 0.3s var(--rebote);
  }

  .escalera li:nth-child(5) img { width: clamp(62px, 76%, 128px); }

  @media (hover: hover) and (pointer: fine) {
    .escalera li:hover img { translate: 0 -10px; }
  }

  /* El peldano sube un tramo fijo por personaje, y se enciende hacia el
     rosa de la marca a medida que sube. El ultimo es de oro. */
  .peldano {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 2px;
    width: 100%;
    min-height: calc(74px + var(--n) * clamp(22px, 3vw, 38px));
    padding: 14px 4px 12px;
    border-radius: 14px 14px 0 0;
    background: color-mix(in oklab, var(--acento-fuerte) calc(26% + var(--n) * 18%), var(--tinta-2));
    text-align: center;
  }

  .escalera li:nth-child(5) .peldano { background: var(--resalte); color: var(--tinta); }

  .peldano strong { font-size: clamp(0.74rem, 1.2vw, 1rem); line-height: 1.2; }

  .peldano span {
    display: grid;
    font-size: clamp(0.66rem, 1vw, 0.8rem);
    font-weight: 500;
    line-height: 1.25;
  }

  .peldano b {
    font-size: clamp(1.15rem, 2.2vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  /* --- La Tienda --------------------------------------------------------- */

  .tienda {
    display: grid;
    grid-template-columns: 4fr 8fr;
    align-items: center;
    gap: clamp(24px, 4vw, 56px);
    margin-top: clamp(64px, 8vw, 104px);
  }

  .tienda-texto { display: grid; gap: 12px; }

  .jugadores {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: clamp(2px, 1vw, 12px);
    padding-bottom: 14px;
    border-bottom: 2px solid rgba(255, 255, 255, 0.22);
  }

  .jugador img {
    width: clamp(58px, 11vw, 132px);
    filter: drop-shadow(0 10px 10px rgba(0, 0, 0, 0.4));
    transition: scale 0.3s var(--rebote);
  }

  .jugador:nth-child(3) img { width: clamp(66px, 12.5vw, 150px); }

  @media (hover: hover) and (pointer: fine) {
    .jugador:hover img { scale: 1.08; }
  }

  @media (max-width: 960px) {
    .app-grid, .banco, .tienda { grid-template-columns: 1fr; }
    .telefonos { max-width: 520px; width: 100%; justify-self: center; min-height: 0; }
    .banco { align-items: start; }
  }

  @media (max-width: 560px) {
    .roles { grid-template-columns: 1fr; gap: 20px; }
    .pegado-1 { width: 80px; }
    .pegado-2 { width: 60px; }
    .peldano { border-radius: 10px 10px 0 0; padding-inline: 2px; }
    /* La palabra "monedas" no cabe en un peldano tan angosto: queda el
       numero, mas grande, y la unidad ya la dice el texto de arriba. */
    .peldano strong { font-size: 0.72rem; }
    .peldano span { font-size: 0; }
    .peldano b { font-size: 1.25rem; }
  }
</style>
