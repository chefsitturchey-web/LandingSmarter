---
import { testimonios } from '../data/site';

const iniciales = (nombre: string) =>
  nombre.split(' ').map((p) => p[0]).slice(0, 2).join('');
---

<section class="seccion" id="testimonios">
  <div class="contenedor">
    <div class="cabecera" data-aparece>
      <span class="etiqueta">Lo que dicen los papás</span>
      <h2>Familias que confían en SMARTER</h2>
    </div>

    <ul class="lista">
      {
        testimonios.map((t, i) => (
          <li class="levanta" data-aparece style={`--i: ${i}`}>
            <blockquote>
              <p>“{t.texto}”</p>
            </blockquote>
            <div class="quien">
              <span class="avatar" aria-hidden="true">{iniciales(t.nombre)}</span>
              <div>
                <strong>{t.nombre}</strong>
                <span>{t.detalle}</span>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .lista {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    padding: 28px;
    border-radius: var(--radio);
    border: 1px solid var(--borde);
  }

  blockquote { margin: 0; font-size: 1.02rem; line-height: 1.6; }

  .quien { display: flex; align-items: center; gap: 12px; }
  .quien div { display: grid; line-height: 1.35; }
  .quien span:not(.avatar) { font-size: 0.85rem; color: var(--texto-suave); }

  .avatar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--morado-suave);
    color: var(--morado);
    font-weight: 700;
    font-size: 0.9rem;
  }

  li:nth-child(2) .avatar { background: var(--rosa-suave); color: var(--rosa); }
  li:nth-child(3) .avatar { background: #E6ECFF; color: var(--azul); }

  @media (max-width: 900px) {
    .lista { grid-template-columns: 1fr; max-width: 560px; }
  }
</style>
