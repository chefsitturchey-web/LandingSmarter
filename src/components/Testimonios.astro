---
import { testimonios } from '../data/site';

const iniciales = (nombre: string) =>
  nombre.split(' ').map((p) => p[0]).slice(0, 2).join('');

const [principal, ...otros] = testimonios;
---

<section class="seccion" id="testimonios">
  <div class="contenedor">
    <div class="cabecera" data-aparece>
      <h2>Familias que confían en SMARTER</h2>
    </div>

    <!-- Una voz en grande y las demas al lado: no tres tarjetas iguales. -->
    <div class="voces">
      <figure class="voz voz-grande" data-aparece>
        <blockquote>
          <p>{principal.texto}</p>
        </blockquote>
        <figcaption>
          <span class="avatar" aria-hidden="true">{iniciales(principal.nombre)}</span>
          <span class="quien">
            <strong>{principal.nombre}</strong>
            <span>{principal.detalle}</span>
          </span>
        </figcaption>
      </figure>

      <div class="voces-lado">
        {
          otros.map((t, i) => (
            <figure class="voz" data-aparece style={`--i: ${i + 1}`}>
              <blockquote>
                <p>{t.texto}</p>
              </blockquote>
              <figcaption>
                <span class="avatar" aria-hidden="true">{iniciales(t.nombre)}</span>
                <span class="quien">
                  <strong>{t.nombre}</strong>
                  <span>{t.detalle}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .voces {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }

  .voz { display: grid; gap: 22px; margin: 0; }

  blockquote { margin: 0; }

  .voz-grande blockquote {
    position: relative;
    padding-top: clamp(56px, 7vw, 84px);
    font-size: clamp(1.5rem, 3vw, 2.3rem);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.025em;
  }

  /* Las comillas de apertura, enormes, del color de la marca. */
  .voz-grande blockquote::before {
    content: '“';
    position: absolute;
    left: -0.04em;
    top: -0.02em;
    font-size: clamp(6rem, 12vw, 9.5rem);
    font-weight: 800;
    line-height: 1;
    color: var(--acento);
  }

  .voces-lado { display: grid; gap: 32px; }

  .voces-lado .voz { padding-top: 28px; border-top: 2px solid var(--tinta); }
  .voces-lado blockquote { font-size: 1.08rem; line-height: 1.6; }

  figcaption { display: flex; align-items: center; gap: 14px; }

  .quien { display: grid; line-height: 1.35; }
  .quien span { font-size: 0.88rem; color: var(--texto-suave); }

  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    background: var(--acento-suave);
    color: var(--acento-fuerte);
    font-weight: 700;
    font-size: 0.9rem;
  }

  .voces-lado .avatar { background: var(--fondo-2); color: var(--tinta); }

  @media (max-width: 900px) {
    .voces { grid-template-columns: 1fr; }
  }
</style>
