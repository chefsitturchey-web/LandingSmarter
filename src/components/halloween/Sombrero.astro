  class?: string;
}

const { class: clase } = Astro.props;
---

<svg class:list={['hw', clase]} viewBox="-55 -95 110 110" aria-hidden="true">
  <path
    d="M-30 0L-6 -62C2 -86 26 -90 36 -72C24 -74 16 -64 16 -52L30 0Z"
    fill="#2A1B3D"
  />
  <path d="M-27 -7L-22 -20H24L28 -7Z" fill="#F2751A" />
  <ellipse cx="0" cy="0" rx="50" ry="10" fill="#2A1B3D" />
</svg>
