---
/**
 * El marco de cualquier pagina: head, fuentes, estilos y la barra de arriba.
 *
 * Hoy solo hay una pagina, pero una seccion nueva (materiales, un portal) se
 * arma igual: `<Base titulo=... descripcion=...>` y su contenido.
 */
import '../styles/global.css';
import '../styles/halloween.css';
import Ambiente from '../components/halloween/Ambiente.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { academia } from '../data/site';

interface Props {
  titulo?: string;
  descripcion?: string;
}

const { titulo = academia.nombre, descripcion = academia.descripcion } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site ?? academia.url).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <meta name="theme-color" content="#FE0081" />
    <link rel="canonical" href={canonica} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/poppins-extrabold.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/poppins-regular.woff" as="font" type="font/woff" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <script is:inline>
      // Halloween: del 1 al 31 de octubre de 2026 la pagina se disfraza sola,
      // y el 1 de noviembre vuelve a lo normal sin publicar nada. Va antes de
      // pintar para que no se vea un salto de colores al cargar.
      //
      // Para verla fuera de fecha, o apagarla dentro: `?temporada=halloween`
      // o `?temporada=normal` al final de la direccion.
      (function () {
        var pedida = new URLSearchParams(location.search).get('temporada');
        var hoy = new Date();
        var enFecha = hoy >= new Date(2026, 9, 1) && hoy < new Date(2026, 10, 1);
        if (pedida === 'halloween' || (pedida !== 'normal' && enFecha)) {
          document.documentElement.dataset.temporada = 'halloween';
          var color = document.querySelector('meta[name="theme-color"]');
          if (color) color.content = '#1B1030';
        }
      })();
    </script>
    <script is:inline>
      // Antes de pintar: si se van a poder animar, lo que entra al bajar
      // empieza escondido. Si no, se ve todo quieto desde el principio.
      if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anim');
      }
    </script>
  </head>
  <body>
    <a class="saltar" href="#contenido">Ir al contenido</a>
    <Nav />
    <main id="contenido">
      <slot />
      <Ambiente />
    </main>
    <Footer />

    <script>
      import { animar } from '../lib/animar';
      animar();
    </script>
  </body>
</html>
