// Publicacion en Cloudflare Workers: la web es estatica, asi que el Worker
// solo sirve lo que deja `npm run build` en dist/.
// El nombre tiene que ser el mismo que el del proyecto en Cloudflare.
{
  "name": "smarter-academy",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
